# Copia este archivo a .env para desarrollo local.  .env está en .gitignore.
# En producción se usa .streamlit/secrets.toml (o los Secrets de Streamlit Cloud),
# que tiene prioridad sobre estas variables.

# Agente IA (módulo 12) — https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: modelo del agente. Por defecto claude-sonnet-5.
# ANTHROPIC_MODEL=claude-sonnet-5
